{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeNotch",
  "version": "0.2.3",
  "identifier": "dev.codenotch.hud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "hud",
        "title": "CodeNotch",
        "url": "index.html",

        "width": 260,
        "height": 40,
        "minWidth": 120,
        "minHeight": 28,

        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,

        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true,
        "visible": false,

        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-extensions --disable-background-networking --disable-component-update --disable-sync --disable-default-apps --no-pings --autoplay-policy=no-user-gesture-required",
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CodeNotch contributors",
    "shortDescription": "AI coding-assistant usage HUD",
    "longDescription": "CodeNotch pins a small always-on-top notch to the edge of your screen showing how much of each AI coding assistant's usage limit you have burned, when the window resets, and whether a background agent is generating, finished, or waiting for your approval.",
    "copyright": "Copyright (c) 2026 CodeNotch contributors",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCODM0MjNGRkFGQThBNzAKUldSd2l2cjZQMEtEVzdqRTlhRWJKaTlYR2ZJNVVOeFZhZm1IOEFUWGJQU0htQ1lGaUJoblVNVW8K",
      "endpoints": [
        "https://github.com/k2wh/CodeNotch-Kawh-Edition-/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
